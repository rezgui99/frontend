# Configuration de l'API
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Chemins des modèles et données
MODEL_PATH=./models
TRAINING_DATA_PATH=./data

# Configuration de la base de données (optionnel)
DATABASE_URL=postgresql://user:password@localhost:5432/smarthire

# Configuration des seuils de recommandation
MIN_TRAINING_PRIORITY=0.3
MIN_JOB_COMPATIBILITY=0.4
MAX_RECOMMENDATIONS=10

# Poids pour le calcul de score
SKILL_WEIGHT=0.7
EXPERIENCE_WEIGHT=0.2
CERTIFICATION_WEIGHT=0.1

# Configuration des niveaux de compétences
SKILL_LEVEL_1_NAME=Débutant
SKILL_LEVEL_2_NAME=Junior
SKILL_LEVEL_3_NAME=Autonome
SKILL_LEVEL_4_NAME=Avancé
SKILL_LEVEL_5_NAME=Expert

# Configuration du logging
LOG_LEVEL=INFO
LOG_FILE=./logs/recommendation_api.log

# Configuration des modèles ML
MODEL_RETRAIN_INTERVAL_DAYS=30
AUTO_RETRAIN_ENABLED=false
MIN_TRAINING_SAMPLES=100

# Configuration de performance
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=300

# Configuration de sécurité (à implémenter)
API_KEY_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Configuration des notifications (optionnel)
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATIONS_ENABLED=false